#!/bin/sh


userresources=$HOME/.Xresources
usermodmap=$HOME/.Xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap


# merge in defaults and keymaps
if [ -f $sysresources ]; then
    xrdb -merge $sysresources
fi

if [ -f $sysmodmap ]; then
    xmodmap $sysmodmap
fi

if [ -f "$userresources" ]; then
    xrdb -merge "$userresources"
fi

if [ -f "$usermodmap" ]; then
    xmodmap "$usermodmap"
fi


# start some nice programs
if [ -d /etc/X11/xinit/xinitrc.d ] ; then
 for f in /etc/X11/xinit/xinitrc.d/?*.sh ; do
  [ -x "$f" ] && . "$f"
 done
 unset f
fi


# start picom
picom &

# set numlock to be on 
numlockx &

# set background (both work laptops have 1920x1200 panels)
feh --no-fehbg --bg-fill ~/hq/etc/wallpapers/eboy_tok_1920_1200.png &

# set keyboard params
xset r rate 250 50 &

# Tap to click is handled by configure-xinput (run from the i3 config), which
# finds the touchpad by name. Don't hardcode xinput ids here: they differ per
# machine (on both diego and diegbro, id 12 is the Intel HID button array).
#
# GDM sources this file from /etc/gdm3/Xsession, which is bash without set -e,
# so a failing line just logs to the journal; keep it POSIX sh anyway.

# map caps-lock to super - only required for IBM Model M. Don't want this for Displaywriter
# setxkbmap -option caps:super &

# # start the emacs server. disown so that exiting x session doesn't kill emacs
# emacs --daemon &

# this is the last thing we do!
# exec startxfce4
# exec i3

# start barrier client to enzo (server config: enzo-arch dots/barrier/)
# Inherits $DISPLAY; screen name is the hostname.
barrierc --disable-crypto 192.168.0.95 &
