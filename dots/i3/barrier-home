#!/usr/bin/env python3
"""Bring the barrier cursor back to this machine (the barrier server).

While the cursor is on a client screen, barriers holds an active grab on this
machine's keyboard and pointer, so i3lock cannot grab them and fails to lock.
The server config binds Control+Alt+Super+Shift+F12 to switchToScreen(<this
host>); this presses that chord through XTEST. Needs only libX11 and libXtst
(no xdotool), and is a harmless no-op when barrier isn't running.
"""

import ctypes
import ctypes.util
import sys
import time

CHORD = ("Control_L", "Alt_L", "Super_L", "Shift_L", "F12")


def main() -> int:
    try:
        x11 = ctypes.CDLL(ctypes.util.find_library("X11") or "libX11.so.6")
        xtst = ctypes.CDLL(ctypes.util.find_library("Xtst") or "libXtst.so.6")
    except OSError as e:
        print(f"barrier-home: {e}", file=sys.stderr)
        return 1

    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XStringToKeysym.restype = ctypes.c_ulong
    x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
    x11.XKeysymToKeycode.restype = ctypes.c_ubyte
    x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x11.XFlush.argtypes = [ctypes.c_void_p]
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    xtst.XTestFakeKeyEvent.argtypes = [
        ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]

    dpy = x11.XOpenDisplay(None)
    if not dpy:
        print("barrier-home: cannot open display", file=sys.stderr)
        return 1

    codes = []
    for name in CHORD:
        code = x11.XKeysymToKeycode(dpy, x11.XStringToKeysym(name.encode()))
        if not code:
            print(f"barrier-home: no keycode for {name}", file=sys.stderr)
            x11.XCloseDisplay(dpy)
            return 1
        codes.append(code)

    for code in codes:
        xtst.XTestFakeKeyEvent(dpy, code, True, 0)
        x11.XFlush(dpy)
        time.sleep(0.02)
    for code in reversed(codes):
        xtst.XTestFakeKeyEvent(dpy, code, False, 0)
        x11.XFlush(dpy)
        time.sleep(0.02)

    x11.XCloseDisplay(dpy)
    return 0


if __name__ == "__main__":
    sys.exit(main())
