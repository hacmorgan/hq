ingredients:
  - butter
  - item: coarse peppercorns
    note: white:black:red, any ratio
  - brandy
  - cream
  - item: fresh pepper
    note: finer cracked, to finish
steps:
  - in steak pan, after searing steak, add butter and coarse peppercorns
  - toast pepper for a bit
  - add brandy
  - flambe & reduce
  - add cream
  - reduce again
  - fresh (finer cracked) pepper to finish
